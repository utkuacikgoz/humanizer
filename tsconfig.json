{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "@cloudflare/workers-types"],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // tests/e2e drives a system-wide Playwright install (not a project
  // dependency, by design — CI has no browser and never runs these), so
  // TypeScript cannot resolve `playwright` here. Typechecking it would
  // fail the build on a module that is intentionally absent.
  "exclude": ["node_modules", "tests/e2e"]
}
